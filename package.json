{
  "name": "rutul-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Rutul Dave's portfolio: a miniature Vadodara toured by toy train. Next.js static export + React Three Fiber.",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "node scripts/check-renders.mjs && next build",
